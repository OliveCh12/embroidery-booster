{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Generate Rungs (Current File)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/embroidery_auto_rung_generator.py",
            "args": [
                "${file}",
                "--verbose",
                "--debug"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Generate Rungs (Fixed File)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/embroidery_auto_rung_generator.py",
            "args": [
                "shape.svg",
                "-s", "4.0"
            ],
            "console": "integratedTerminal"
        }
    ]
}
